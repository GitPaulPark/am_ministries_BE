# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/church?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=church
DB_PASSWORD=church

# Mirror values used by docker-compose.yml
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=church
MYSQL_USER=church
MYSQL_PASSWORD=church
MYSQL_PORT=3306

# --- JWT ---
# Must be ≥ 32 bytes (256 bits). Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-real-256-bit-secret-replace-me
JWT_ISSUER=msc-church
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Uploads ---
UPLOADS_DIR=uploads
