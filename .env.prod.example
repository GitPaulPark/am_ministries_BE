# Copy this file to .env.prod (one level ABOVE the am-backend repo), fill in
# the blanks, and run docker compose with --env-file ../.env.prod. Never
# commit the real values.

# --- Domain + TLS -----------------------------------------------------------
DOMAIN=church.example.com
TLS_EMAIL=you@yourchurch.org

# --- Database ---------------------------------------------------------------
# Root password is used ONLY by the mysql container's healthcheck + manual
# admin access. The backend uses the DB_PASSWORD on the `church` user.
MYSQL_ROOT_PASSWORD=generate-with-openssl-rand-base64-32
DB_PASSWORD=generate-with-openssl-rand-base64-32

# --- JWT --------------------------------------------------------------------
# 48 bytes base64 → ≥256 bits. Spring refuses to start on anything shorter.
# Generate with:  openssl rand -base64 48
JWT_SECRET=generate-with-openssl-rand-base64-48

# --- First admin ------------------------------------------------------------
# ProdDataInitializer seeds this ADMIN on first boot with
# password_change_required=true, so this password is only alive long enough
# to reach the forced /me/password screen.
INITIAL_ADMIN_EMAIL=pastor@yourchurch.org
INITIAL_ADMIN_PASSWORD=change-me-right-after-first-login

# --- Error tracking (optional) ---------------------------------------------
# Leave empty to disable the Sentry SDK entirely.
SENTRY_DSN=
SENTRY_ENV=prod

# --- AI pipeline (optional) -------------------------------------------------
# Leave MSC_AI_ENABLED=false unless you have both GROQ + ANTHROPIC keys.
MSC_AI_ENABLED=false
GROQ_API_KEY=
ANTHROPIC_API_KEY=
